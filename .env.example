# Postgres (policy/claim data, LangGraph checkpointer, LLM response cache)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ins_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ins_agent

# Langfuse (your own instance)
LANGFUSE_HOST=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# LLM provider: groq | openrouter
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
# Required only when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Model tiers (concrete model name per tier, interpreted per LLM_PROVIDER)
MODEL_FAST=llama-3.1-8b-instant
MODEL_REASONING=llama-3.3-70b-versatile

# Policy Resolution tuning
MATCH_THRESHOLD=0.7
TOP_N=5
MAX_RETRY_ATTEMPTS=3
